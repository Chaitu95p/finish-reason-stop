{
  "permissions": {
    "allow": [
      "Bash(uv run *)",
      "Bash(uv add *)",
      "Bash(uv sync)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(mkdir -p *)",
      "Bash(ruff check *)",
      "Bash(ruff format *)",
      "Bash(python -m mypy *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(pip install *)",
      "Bash(pip3 install *)",
      "Bash(curl * | bash)",
      "Bash(wget * | bash)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "command": "bash .claude/hooks/pre-tool-use.sh"
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "command": "bash .claude/hooks/post-tool-use.sh"
      }
    ]
  }
}
